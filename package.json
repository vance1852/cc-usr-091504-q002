{
  "name": "off-campus-mentor-admission",
  "version": "1.0.0",
  "description": "校外编程导师准入与当日通行凭证系统（NestJS + SQLite）",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-sqlite dist/main.js",
    "seed:serve": "SEED_ON_BOOT=1 SQLITE_FILE=data/admissions.sqlite node --experimental-sqlite dist/main.js",
    "test": "NODE_OPTIONS=--experimental-sqlite jest --config jest.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  }
}
